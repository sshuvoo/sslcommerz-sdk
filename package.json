{
  "name": "sslcommerz-sdk-ts",
  "version": "1.0.0",
  "description": "SSLCommerz Node.js TypeScript SDK — Payment gateway integration for Bangladesh. Supports payment initiation, validation, refunds, and transaction queries. Modern ESM, strict typing, zero runtime dependencies.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "sslcommerz",
    "sslcommerz-sdk-ts",
    "sslcommerz-sdk",
    "sslcommerz-lts",
    "payment",
    "payment-gateway",
    "payment-integration",
    "gateway",
    "sdk",
    "typescript",
    "node",
    "nodejs",
    "node-js",
    "bangladesh",
    "bdt",
    "refund",
    "transaction",
    "ecommerce",
    "online-payment",
    "merchant",
    "api",
    "nest",
    "express"
  ],
  "author": "sshuvo",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sshuvoo/sslcommerz-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/sshuvoo/sslcommerz-sdk/issues"
  },
  "homepage": "https://github.com/sshuvoo/sslcommerz-sdk#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
